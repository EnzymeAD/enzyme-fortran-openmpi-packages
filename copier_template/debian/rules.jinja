#!/usr/bin/make -f

VERSION = 5.0.11
TARBALL = openmpi-$(VERSION).tar.gz
URL = https://download.open-mpi.org/release/open-mpi/v5.0/$(TARBALL)

# dpkg-buildpackage injects GCC-specific compiler flags;
# specify them ourselves so clang/flang accept them.
#
# We need to specify -gdwarf-4 because clang/flang default to DWARF 5,
# which `dwz` a tool to commpress the debug info does not support yet
# https://sourceware.org/bugzilla/show_bug.cgi?id=24726
# Since dh is trying to run dwz, we either need to specify the flags
# or override that step of the build with an empty `override_dh_dwz` target
export CFLAGS = -g -O2 -gdwarf-4
export CXXFLAGS = -g -O2 -gdwarf-4
export FFLAGS = -g -O2 -gdwarf-4
export FCFLAGS = -g -O2 -gdwarf-4
export CPPFLAGS =
export LDFLAGS =

%:
	dh $@ --without autoreconf

# Download, extract, and configure in one step
override_dh_auto_configure:
	wget -N --progress=dot:mega $(URL)
	tar --strip-components=1 -xf $(TARBALL)
	dh_auto_configure -- \
		--prefix=/usr \
		--enable-mpi-fortran=all \
		--with-hwloc=external \
		--with-libevent=external \
		CFLAGS="$(CFLAGS)" \
		CXXFLAGS="$(CXXFLAGS)" \
		FFLAGS="$(FFLAGS)" \
		FCFLAGS="$(FCFLAGS)" \
		CPPFLAGS="$(CPPFLAGS)" \
		LDFLAGS="$(LDFLAGS)"

# Skip tests during packaging
override_dh_auto_test:
